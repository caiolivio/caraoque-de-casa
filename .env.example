# Copie este arquivo para .env e ajuste se quiser.

# Porta do servidor
PORT=3000

# PIN do anfitrião (pular, pausar, reordenar). Se ficar vazio, um PIN aleatório aparece no terminal.
HOST_PIN=

# Chave da YouTube Data API v3 (opcional, mas deixa a busca mais confiável).
# Sem chave, a busca lê a página de resultados do YouTube.
YOUTUBE_API_KEY=

# Endereço que vai no QR code. Deixe vazio para detectar o IP do PC automaticamente.
# Exemplo com Cloudflare Tunnel: PUBLIC_URL=https://karaoke.seudominio.com
PUBLIC_URL=
